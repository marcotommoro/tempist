# ============================================================================
# Database (Postgres locale via Homebrew o Postgres self-hosted in produzione)
# Locale: createdb todoist_dev && createdb todoist_test
# Produzione: Coolify gestisce un container Postgres dedicato
# ============================================================================
DATABASE_URL="postgresql://USERNAME@localhost:5432/todoist_dev?schema=public"

# Test database (usato dai test integration)
TEST_DATABASE_URL="postgresql://USERNAME@localhost:5432/todoist_test?schema=public"

# ============================================================================
# Better Auth
# - BETTER_AUTH_SECRET: random string 32+ chars (es. `openssl rand -base64 32`)
# - BETTER_AUTH_URL: URL pubblico dell'app (in dev: http://localhost:3000)
# ============================================================================
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ============================================================================
# OAuth Providers (Better Auth socialProviders)
# Google: https://console.cloud.google.com → OAuth Client ID
#   Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# GitHub: https://github.com/settings/developers → OAuth App
#   Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
# ============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# Email (Resend)
# https://resend.com → API Keys
# In dev senza chiave: il magic link verrà loggato su console (non spedito davvero)
# ============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# ============================================================================
# pg-boss
# Usa lo stesso DATABASE_URL dell'app — pg-boss creerà uno schema `pgboss`
# automaticamente al primo `boss.start()`
# ============================================================================
# (nessuna variabile dedicata: legge DATABASE_URL)

# ============================================================================
# Application
# ============================================================================
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ============================================================================
# Calendar integrations (Fase 4 — non bloccanti per dev locale)
# ============================================================================
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# MICROSOFT_GRAPH_CLIENT_ID=""
# MICROSOFT_GRAPH_CLIENT_SECRET=""

# ============================================================================
# Token encryption (Fase 4 — per cifrare access/refresh token OAuth provider calendar)
# Random 32-byte hex string (es. `openssl rand -hex 32`)
# ============================================================================
# TOKEN_ENCRYPTION_KEY=""
