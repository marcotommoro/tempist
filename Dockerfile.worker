# Worker pg-boss — gira accanto a todoist-app come container separato su Coolify
# Stesso DATABASE_URL dell'app

# ---- deps ----
FROM node:22-alpine AS deps
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM node:22-alpine AS build
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm worker:build

# ---- runtime ----
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Solo node_modules di prod + worker bundlato
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist/worker ./worker
COPY package.json ./

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
USER worker

CMD ["node", "worker/index.js"]
