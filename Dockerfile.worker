# syntax=docker/dockerfile:1
# Worker pg-boss — gira accanto a todoist-app come container separato su Coolify.
# Stesso DATABASE_URL dell'app (iniettato a runtime, non build-time).
#
# Nessun build secret qui: tsup è puro bundler, non esegue codice applicativo
# durante la build, quindi non serve montare env durante `pnpm worker:build`.

# ---- deps ----
FROM node:26-alpine AS deps
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN apk add --no-cache libc6-compat && npm install -g pnpm@10
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM node:26-alpine AS build
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN apk add --no-cache libc6-compat && npm install -g pnpm@10
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm worker:build

# ---- runtime ----
FROM node:26-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache libc6-compat

# Solo node_modules di prod + worker bundlato
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/dist/worker  ./worker
COPY package.json ./

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
USER worker

CMD ["node", "worker/index.js"]
